# Which model to use: mock (offline demo) | groq | ollama | openai_compatible
LLM_PROVIDER=mock

# Groq free tier: create a key at console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b   (check console.groq.com/docs/models for current IDs)

# Local Ollama (run `ollama pull llama3.1:8b` first)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b

# Any other OpenAI-compatible endpoint
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=...
# LLM_MODEL=...

EVAL_MAX_RETRIES=3
MOCK_DELAY=0.9

# Fair use of the host's key in the public app
HOSTED_REVIEWS_PER_HOUR=3
HOSTED_REVIEWS_PER_DAY=25
LLM_MAX_TOKENS=1800
